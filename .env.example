DATABASE_URL=mongodb://127.0.0.1/johanna-gustav-wedding
PAYLOAD_SECRET=change-me-to-a-long-random-string
# Public URL of the site (used for metadata / Open Graph)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# First admin user created by `pnpm seed` (only when no user exists yet) – change after first login
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-before-launch

# Email (optional). Without RESEND_API_KEY nothing is sent: Payload logs emails to the console.
# RESEND_API_KEY=re_xxxxxxxx
# Sender for all mail – the domain must be verified in Resend
EMAIL_FROM_ADDRESS=noreply@example.com
EMAIL_FROM_NAME=Johanna & Gustav
# Who gets the notification when a guest replies (comma-separated for several). Falls back to Site settings → contact email.
RSVP_NOTIFY_TO=johanna@example.com,gustav@example.com
